<html>
<head>
<meta charset="utf-8"/>
<title>Regulatory Change Intelligence</title>
<style>
.grc-light{--grc-bg:240,243,247;--grc-surface:255,255,255;--grc-surface2:247,249,252;--grc-raised:255,255,255;--grc-sunken:247,249,252;--grc-border:222,228,236;--grc-text:18,28,42;--grc-muted:82,96,118;--grc-faint:130,144,165;--grc-primary:0,113,188;--grc-ai:124,92,219;--grc-crit:214,48,49;--grc-high:201,123,0;--grc-healthy:30,150,90;--grc-info:0,113,188;}
