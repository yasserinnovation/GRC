[dir="rtl"]{text-align:right}

:root{--grc-bg:15,20,32;--grc-surface:23,30,46;--grc-surface2:30,39,59;--grc-raised:34,44,66;--grc-sunken:11,21,38;--grc-border:44,56,82;--grc-text:232,237,245;--grc-muted:148,163,193;--grc-faint:108,122,150;--grc-primary:56,139,253;--grc-ai:167,139,250;--grc-crit:248,81,73;--grc-high:245,158,11;--grc-healthy:46,204,113;--grc-info:56,139,253;}
body{font-family:"Lato",Arial,sans-serif !important;}

html,body{margin:0;padding:0;background:rgb(var(--grc-bg));color:rgb(var(--grc-text));font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;font-size:14px}
.wrap{max-width:1280px;margin:0 auto;padding:18px 22px 60px}
.hdr{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:1px solid rgb(var(--grc-border));padding-bottom:14px;margin-bottom:14px}
.crumb{color:#7f93b2;font-size:12px;margin-bottom:6px}
.crumb b{color:#aebcd6}
.h1{font-size:20px;font-weight:700;letter-spacing:.2px}
.sub{color:#93a4bd;font-size:12px;margin-top:3px}
.badge{display:inline-block;padding:2px 9px;border-radius:11px;font-size:11px;font-weight:600;margin-left:6px}
.badge.live{background:#07331f;color:#34d399;border:1px solid #10b981}
.badge.demo{background:#3a2a06;color:#fbbf24;border:1px solid #f59e0b}
.toolbar{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}
.btn{background:rgb(var(--grc-surface2));color:#dbe6f7;border:1px solid rgb(var(--grc-border));border-radius:7px;padding:8px 13px;font-size:13px;cursor:pointer;transition:.15s}
.btn:hover{background:#1e2d49}
.btn.primary{background:rgb(var(--grc-primary));border-color:rgb(var(--grc-primary));color:#fff}
.btn.primary:hover{background:#255fd0}
.btn.ai{background:rgb(var(--grc-ai));border-color:rgb(var(--grc-ai));color:#fff}
.btn.ai:hover{background:rgb(var(--grc-ai))}
.btn:disabled{opacity:.4;cursor:not-allowed}
.stepper{display:flex;gap:6px;margin-bottom:16px;flex-wrap:wrap}
.step{flex:1;min-width:110px;background:rgb(var(--grc-surface));border:1px solid rgb(var(--grc-border));border-radius:7px;padding:8px 10px;font-size:12px;color:#7f93b2;position:relative}
.step .n{font-weight:700;font-size:11px;text-transform:uppercase;letter-spacing:.4px}
.step.done{background:#10233f;border-color:rgb(var(--grc-primary));color:#cfe0ff}
.step.done .n{color:#6ea0ff}
.layout{display:grid;grid-template-columns:320px 1fr;gap:16px}
.panel{background:rgb(var(--grc-surface));border:1px solid rgb(var(--grc-border));border-radius:10px;padding:14px}
.panel h3{margin:0 0 10px;font-size:13px;color:#aebcd6;text-transform:uppercase;letter-spacing:.5px}
.pub{border:1px solid rgb(var(--grc-border));border-radius:8px;padding:10px;margin-bottom:8px;cursor:pointer;background:rgb(var(--grc-surface2))}
.pub:hover{border-color:rgb(var(--grc-primary))}
.pub.sel{border-color:rgb(var(--grc-primary));background:rgb(var(--grc-raised))}
.pub .t{font-size:13px;font-weight:600;line-height:1.3;color:#eaf1fb}
.pub .m{font-size:11px;color:#7f93b2;margin-top:4px}
.tabs{display:flex;gap:4px;border-bottom:1px solid rgb(var(--grc-border));margin-bottom:14px;flex-wrap:wrap}
.tab{padding:8px 13px;font-size:13px;color:#93a4bd;cursor:pointer;border-bottom:2px solid transparent}
.tab.active{color:#fff;border-bottom-color:rgb(var(--grc-ai))}
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(135px,1fr));gap:10px;margin-bottom:14px}
.kpi{background:rgb(var(--grc-surface2));border:1px solid rgb(var(--grc-border));border-radius:9px;padding:12px}
.kpi .v{font-size:24px;font-weight:700;color:#eaf1fb}
.kpi .l{font-size:11px;color:#7f93b2;margin-top:3px;text-transform:uppercase;letter-spacing:.4px}
.row{border:1px solid rgb(var(--grc-border));border-radius:8px;padding:11px;margin-bottom:9px;background:rgb(var(--grc-surface2))}
.row .top{display:flex;justify-content:space-between;gap:10px;align-items:center}
.row .ttl{font-weight:600;color:#eaf1fb;font-size:13px}
.row .meta{font-size:12px;color:#8aa0c0;margin-top:5px;line-height:1.45}
.pill{display:inline-block;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:600}
.pill.high,.pill.critical{background:#3a0d0d;color:#f87171;border:1px solid #ef4444}
.pill.medium{background:#3a2a06;color:#fbbf24;border:1px solid #f59e0b}
.pill.low{background:#07331f;color:#34d399;border:1px solid #10b981}
.pill.policy{background:#0d2440;color:#7fb0ff;border:1px solid rgb(var(--grc-primary))}
.pill.control{background:#1f1540;color:#b79cff;border:1px solid rgb(var(--grc-ai))}
.pill.risk{background:#3a0d0d;color:#f87171;border:1px solid #ef4444}
.pill.accepted{background:#07331f;color:#34d399;border:1px solid #10b981}
.pill.modified{background:#3a2a06;color:#fbbf24;border:1px solid #f59e0b}
.pill.rejected{background:#3a0d0d;color:#f87171;border:1px solid #ef4444}
.pill.pending,.pill.detected,.pill.draft{background:#1a2740;color:#9fb3d4;border:1px solid #33496e}
.pill.open,.pill.analyzed,.pill.mapped,.pill.reviewed{background:#0d2440;color:#7fb0ff;border:1px solid rgb(var(--grc-primary))}
.mini{font-size:12px;padding:5px 10px;border-radius:6px;border:1px solid rgb(var(--grc-border));background:rgb(var(--grc-surface2));color:#dbe6f7;cursor:pointer;margin-left:5px}
.mini.a{border-color:#10b981;color:#34d399}
.mini.m{border-color:#f59e0b;color:#fbbf24}
.mini.r{border-color:#ef4444;color:#f87171}
.src{font-size:13px;line-height:1.6;color:rgb(var(--grc-text));white-space:pre-wrap;max-height:360px;overflow:auto;background:rgb(var(--grc-sunken));border:1px solid rgb(var(--grc-border));border-radius:8px;padding:12px;direction:auto}
.kv{display:flex;gap:8px;margin:4px 0;font-size:13px}
.kv .k{color:#7f93b2;min-width:120px}
.brief .b{background:rgb(var(--grc-surface2));border:1px solid rgb(var(--grc-border));border-left:3px solid rgb(var(--grc-ai));border-radius:8px;padding:11px;margin-bottom:8px}
.brief .b .k{font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:#b79cff;margin-bottom:4px}
.feed .e{font-size:12px;color:#9fb3d4;padding:7px 0;border-bottom:1px solid #1a2740}
.feed .e .ty{color:#6ea0ff;font-weight:600}
.empty{color:#6a7f9e;font-size:13px;padding:20px;text-align:center}
.toast{position:fixed;bottom:20px;right:20px;background:rgb(var(--grc-raised));border:1px solid rgb(var(--grc-primary));color:#eaf1fb;padding:12px 16px;border-radius:8px;max-width:380px;font-size:13px;box-shadow:0 8px 30px rgba(0,0,0,.5);z-index:99;display:none}
.toast.err{border-color:#ef4444}
.spin{color:#6ea0ff;font-size:12px}
.modal{position:fixed;inset:0;background:rgba(5,10,20,.7);display:none;align-items:center;justify-content:center;z-index:50}
.modal .box{background:rgb(var(--grc-surface));border:1px solid rgb(var(--grc-border));border-radius:10px;padding:18px;width:560px;max-width:92vw}
.modal textarea{width:100%;height:150px;background:rgb(var(--grc-sunken));color:rgb(var(--grc-text));border:1px solid rgb(var(--grc-border));border-radius:7px;padding:10px;font-size:13px;box-sizing:border-box}
.modal input{width:100%;background:rgb(var(--grc-sunken));color:rgb(var(--grc-text));border:1px solid rgb(var(--grc-border));border-radius:7px;padding:9px;font-size:13px;box-sizing:border-box;margin-bottom:8px}

/*LIGHTFIX*/.grc-light .pub .t,.grc-light .kpi .v,.grc-light .row .ttl,.grc-light .src,.grc-light .h1{color:rgb(18,28,42) !important;}.grc-light .crumb,.grc-light .crumb b,.grc-light .sub,.grc-light .panel h3,.grc-light .tab,.grc-light .pub .m,.grc-light .kpi .l,.grc-light .kv .k,.grc-light .row .meta{color:rgb(82,96,118) !important;}.grc-light .empty{color:rgb(130,144,165) !important;}.grc-light .btn{color:rgb(18,28,42);}.grc-light .btn.primary,.grc-light .btn.ai{color:#fff;}.grc-light .tab.active{color:rgb(0,113,188) !important;}.grc-light .pub,.grc-light .row,.grc-light .kpi,.grc-light .panel{box-shadow:0 1px 4px rgba(31,45,70,.08);}
</style>
</head>
<body>
<button id="themeBtn" class="themebtn" onclick="toggleTheme()">◑ Theme</button>
<div class="wrap">
  <div class="hdr">
    <div>
      <a href="/x_snc_se_grc_vp_0_command_center.do?tab=ai" style="color:#6ea0ff;text-decoration:none;font-size:12px;display:inline-block;margin-bottom:8px">← Back to Command Center</a><div class="crumb">GRC VP Command Center › AI Insights and Actions › <b>Regulatory Impact</b> › Change Details</div>
      <div class="h1">Regulatory Change Intelligence</div>
      <div class="sub" id="subTitle">Umm Al-Qura regulatory monitoring, AI analysis and GRC impact</div>
    </div>
    <div style="text-align:right"><div class="sub">Impact level</div><div id="impactLevel" class="h1" style="font-size:16px">-</div></div>
  </div>
  <div class="toolbar" id="toolbar"></div>
  <div class="stepper" id="stepper"></div>
  <div class="cards" id="kpiStrip" style="margin-bottom:16px"></div>
  <div class="layout">
    <div class="panel">
      <h3>Latest Publications</h3>
      <div id="pubList"><div class="empty">Loading...</div></div>
    </div>
    <div class="panel">
      <div class="tabs" id="tabs"></div>
      <div id="tabBody"><div class="empty">Select a publication to begin.</div></div>
    </div>
  </div>
</div>
<div class="modal" id="modal"><div class="box">
  <h3 style="margin-top:0;color:#aebcd6">Import regulatory text (PDF fallback)</h3>
  <input id="impTitle" placeholder="Title"/>
  <textarea id="impText" placeholder="Paste the full regulatory text here..."></textarea>
  <div style="margin-top:10px;text-align:right">
    <button class="btn" onclick="closeModal()">Cancel</button>
    <button class="btn primary" onclick="doImport()">Import and Select</button>
  </div>
</div></div>
<div class="toast" id="toast"></div>
<script>window.G_CK="$[gs.getSession().getSessionToken() || gs.getSessionToken()]";</script>
<script>

var BASE='/api/x_snc_champion_i_0/reg_intel/v1/execute';
var S={pubs:[],sel:null,wb:null,tab:'Overview'};
function applyTheme(t){try{document.body.classList.remove('grc-light');if(t==='light'){document.body.classList.add('grc-light');}localStorage.setItem('grcTheme',t);var b=document.getElementById('themeBtn');if(b){b.innerHTML=(t==='light'?'◑ Dark':'◐ Light');}}catch(e){}}function toggleTheme(){var cur=(localStorage.getItem('grcTheme')||'light');applyTheme(cur==='light'?'dark':'light');}(function(){var q=(location.search||'');var t=null;var m=q.match(/theme=(light|dark)/);if(m){t=m[1];}else{t=localStorage.getItem('grcTheme')||'light';}applyTheme(t);})();
var TABS=['Overview','Source','AI Analysis','GRC Impact','Actions','Risk','Executive'];
function toast(msg,err){var t=document.getElementById('toast');t.textContent=msg;t.className='toast'+(err?' err':'');t.style.display='block';setTimeout(function(){t.style.display='none';},err?6000:3500);}
function call(op,args){return fetch(BASE,{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json','Accept':'application/json','X-UserToken':window.G_CK},body:JSON.stringify({op:op,args:args||{}})}).then(function(r){if(!r.ok){return r.text().then(function(t){return {ok:false,error:'HTTP '+r.status,_raw:(t||'').substring(0,160)};});}return r.json();}).then(function(j){var d=(j$[AMP]$[AMP]j.result)?j.result:j;if(d$[AMP]$[AMP]d.ok===false)toast((d.error||'Operation failed')+(d.hint?(' '+d.hint):''),true);return d;}).catch(function(e){toast('Network error: '+e,true);return {ok:false,error:''+e};});}
function esc(s){s=(s==null?'':''+s);return s.split('$[AMP]').join('$[AMP]amp;').split('<').join('$[AMP]lt;').split('>').join('$[AMP]gt;');}
function pill(v,cls){return '<span class="pill '+(cls||v)+'">'+esc(v)+'</span>';}
function busy(id){var b=document.getElementById(id);if(b){b.disabled=true;b.dataset.t=b.textContent;b.textContent='Working...';}}
function unbusy(id){var b=document.getElementById(id);if(b){b.disabled=false;if(b.dataset.t)b.textContent=b.dataset.t;}}

function renderToolbar(){
  var sel=!!S.sel;
  var defs=[
    ['Check RSS','primary',"checkRSS()",false],
    ['Demo RSS','ghost',"demoRSS()",false],
    ['Import Text / PDF','ghost',"openModal()",false],
    ['Analyze with AI','ai',"act('analyzeRegulation','Analyze with AI')",!sel],
    ['Run Impact Analysis','ai',"act('runImpactAnalysis','Run Impact Analysis')",!sel],
    ['Generate Actions','ai',"act('generateActions','Generate Actions')",!sel],
    ['Create Tasks','primary',"act('createTasks','Create Tasks')",!sel],
    ['Assess Risk','ai',"act('assessRisk','Assess Risk')",!sel]
  ];
  var h='';for(var i=0;i<defs.length;i++){var d=defs[i];h+='<button id="tb'+i+'" class="btn '+(d[1]==='ghost'?'':d[1])+'" '+(d[3]?'disabled':'')+' onclick="'+d[2]+'">'+d[0]+'</button>';}
  document.getElementById('toolbar').innerHTML=h;
}
function renderStepper(){
  var order=[['detected','Detected'],['analyzed','Analyzed'],['mapped','Mapped'],['reviewed','Reviewed'],['actions_created','Actions Created'],['risk_assessed','Risk Assessed']];
  var cur=S.wb$[AMP]$[AMP]S.wb.workflow?S.wb.workflow.current:null;var oi=-1;for(var i=0;i<order.length;i++)if(order[i][0]===cur)oi=i;
  var h='';for(var j=0;j<order.length;j++){h+='<div class="step'+(j<=oi?' done':'')+'"><div class="n">Step '+(j+1)+'</div>'+order[j][1]+'</div>';}
  document.getElementById('stepper').innerHTML=h;
}
function renderTabs(){var h='';for(var i=0;i<TABS.length;i++){h+='<div class="tab'+(TABS[i]===S.tab?' active':'')+'" onclick="setTab(\''+TABS[i]+'\')">'+TABS[i]+'</div>';}document.getElementById('tabs').innerHTML=h;}
function setTab(t){S.tab=t;renderTabs();renderBody();}

function renderList(){
  if(!S.pubs.length){document.getElementById('pubList').innerHTML='<div class="empty">No publications. Click Check RSS or Demo RSS.</div>';return;}
  var h='';for(var i=0;i<S.pubs.length;i++){var p=S.pubs[i];h+='<div class="pub'+(p.sys_id===S.sel?' sel':'')+'" onclick="selectPub(\''+p.sys_id+'\')"><div class="t" dir="auto">'+esc(p.title)+'</div><div class="m">'+esc(p.category||'')+' · '+esc(p.publication_date||'')+' '+(p.is_demo?'<span class="badge demo">DEMO</span>':'<span class="badge live">LIVE</span>')+'</div></div>';}
  document.getElementById('pubList').innerHTML=h;
}
function renderBody(){
  var el=document.getElementById('tabBody');
  if(!S.wb){el.innerHTML='<div class="empty">Select a publication to begin.</div>';return;}
  var w=S.wb,p=w.publication,c=w.counts||{};
  if(S.tab==='Overview'){
    var cards=[['requirements','Requirements'],['obligations','New Obligations'],['impacted_policies','Impacted Policies'],['impacted_controls','Impacted Controls'],['impacted_departments','Impacted Depts'],['impacted_risks','Related Risks'],['open_actions','Open Actions']];
    var h='<div class="cards">';for(var i=0;i<cards.length;i++)h+='<div class="kpi"><div class="v">'+(c[cards[i][0]]!=null?c[cards[i][0]]:0)+'</div><div class="l">'+cards[i][1]+'</div></div>';h+='</div>';
    h+='<div class="row"><div class="ttl" dir="auto">'+esc(p.title)+'</div><div class="meta">'+esc(p.summary||'')+'</div></div>';
    el.innerHTML=h;
  } else if(S.tab==='Source'){
    var h='<div class="kv"><div class="k">Title</div><div>'+esc(p.title)+'</div></div>';
    h+='<div class="kv"><div class="k">Authority</div><div>'+esc(p.authority||'-')+'</div></div>';
    h+='<div class="kv"><div class="k">Source</div><div>'+esc(p.source_label||p.source)+' '+(p.is_demo?'<span class="badge demo">DEMONSTRATION</span>':'<span class="badge live">LIVE</span>')+'</div></div>';
    h+='<div class="kv"><div class="k">Published</div><div>'+esc(p.publication_date||'-')+'</div></div>';
    h+='<div class="kv"><div class="k">Language</div><div>'+esc(p.language||'-')+'</div></div>';
    if(p.source_url)h+='<div class="kv"><div class="k">Link</div><div><a href="'+esc(p.source_url)+'" target="_blank" style="color:#6ea0ff">Open original</a></div></div>';
    h+='<h3 style="margin-top:14px;color:#aebcd6">Source text</h3><div class="src">'+esc(p.summary||'(no text)')+'</div>';
    el.innerHTML=h;
  } else if(S.tab==='AI Analysis'){
    if(!w.requirements.length){el.innerHTML='<div class="empty">No analysis yet. Click Analyze with AI.</div>';return;}
    var h='<div class="sub" style="margin-bottom:10px">AI relevance '+esc(p.ai_relevance||'-')+' / 100 · impact '+esc(p.impact_level)+'</div>';
    for(var i=0;i<w.requirements.length;i++){var r=w.requirements[i];h+='<div class="row"><div class="top"><div class="ttl" dir="auto">R'+r.seq+'. '+esc(r.text)+'</div><div>'+pill(r.type,'low')+(r.is_obligation?' '+pill('obligation','control'):'')+'</div></div>'+(r.evidence?'<div class="meta">Evidence: '+esc(r.evidence)+(r.effective_date?(' · effective '+esc(r.effective_date)):'')+'</div>':'')+'</div>';}
    el.innerHTML=h;
  } else if(S.tab==='GRC Impact'){
    if(!w.impacts.length){el.innerHTML='<div class="empty">No impact mappings yet. Click Run Impact Analysis.</div>';return;}
    var h='';for(var i=0;i<w.impacts.length;i++){var m=w.impacts[i];var chain='<div class="meta" style="margin-top:6px"><b style="color:#b79cff">Traceability:</b> '+esc(m.publication_title||p.title)+' → '+(m.obligation?'Obligation':'Requirement')+' → '+pill(m.record_type,m.record_type)+' '+esc(m.target_label)+(m.department?(' → '+esc(m.department)):'')+'</div>';var reqline=m.requirement_text?('<div class="meta" dir="auto"><b>Obligation:</b> '+esc(m.requirement_text)+'</div>'):'';var evline=m.evidence?('<div class="meta"><b>Evidence:</b> '+esc(m.evidence)+'</div>'):'';var aireason='<div class="meta"><b>AI reasoning:</b> '+esc(m.reason)+'</div>';var revline=(m.decision&&m.decision!=='pending')?('<div class="meta" style="color:#7f93b2">Decision: '+esc(m.decision)+(m.reviewer?(' by '+esc(m.reviewer)):'')+(m.reviewed_on?(' on '+esc(m.reviewed_on)):'')+'</div>'):'';h+='<div class="row"><div class="top"><div class="ttl" dir="auto">'+pill(m.record_type,m.record_type)+' '+esc(m.target_label)+'</div><div>'+pill(m.priority,m.priority)+' '+pill(m.decision,m.decision)+'</div></div>'+chain+reqline+evline+aireason+revline+'<div style="margin-top:8px"><button class="mini a" onclick="decide(\''+m.sys_id+'\',\'accepted\')">Accept</button><button class="mini m" onclick="decide(\''+m.sys_id+'\',\'modified\')">Modify</button><button class="mini r" onclick="decide(\''+m.sys_id+'\',\'rejected\')">Reject</button></div></div>';}
    el.innerHTML=h;
  } else if(S.tab==='Actions'){
    if(!w.actions.length){el.innerHTML='<div class="empty">No actions yet. Accept mappings, then Generate Actions and Create Tasks.</div>';return;}
    var h='';for(var i=0;i<w.actions.length;i++){var a=w.actions[i];h+='<div class="row"><div class="top"><div class="ttl" dir="auto">'+(a.task_number?('['+esc(a.task_number)+'] '):'')+esc(a.short_description)+'</div><div>'+pill(a.priority,a.priority)+' '+pill(a.status,a.status)+'</div></div><div class="meta">Owner: '+esc(a.assigned_to||'-')+' · BU: '+esc(a.business_unit||'-')+' · Due: '+esc(a.due_date||'-')+'</div></div>';}
    el.innerHTML=h;
  } else if(S.tab==='Risk'){
    if(!w.risk_assessments.length){el.innerHTML='<div class="empty">No risk reassessment yet. Click Assess Risk.</div>';return;}
